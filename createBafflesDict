FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Floors between mid-rack sims only (paper: stacked 10U simulators).
// Neighbour racks + overhead above racks are open fluid (no solid blanks).

internalFacesOnly   true;

baffles
{
    floor_s2
    {
        type        faceZone;
        zoneName    floor_s2;
        patchPairs
        {
            type    wall;
            patchFields
            {
                U       { type noSlip; }
                T       { type zeroGradient; }
                p_rgh   { type fixedFluxPressure; value uniform 0; }
                p       { type calculated; value uniform 0; }
                k       { type kqRWallFunction; value uniform 0.0089; }
                epsilon
                {
                    type            epsilonWallFunction;
                    lowReCorrection on;
                    value           uniform 0.0018;
                }
                nut     { type nutUSpaldingWallFunction; value uniform 0; }
                alphat
                {
                    type    alphatJayatillekeWallFunction;
                    Prt     0.85;
                    value   uniform 0;
                }
            }
        }
    }

