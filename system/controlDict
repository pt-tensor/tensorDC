// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     buoyantBoussinesqSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         20000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      3;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    tileInletAvg
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        writeControl    timeStep;
        writeInterval   10;
        writeFields     false;
        log             true;
        regionType      patch;
        name            tileInlet;
        operation       areaAverage;
        fields          ( T U );
    }
    returnOutletAvg
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        writeControl    timeStep;
        writeInterval   10;
        writeFields     false;
        log             true;
        regionType      patch;
        name            returnOutlet;
        operation       areaAverage;
        fields          ( T U );
    }
    fieldMinMax_TU
    {
        type            fieldMinMax;
        libs            ( fieldFunctionObjects );
        writeControl    timeStep;
        writeInterval   50;
        log             true;
        mode            magnitude;
        fields          ( T U k );
    }
    probes_simulators
    {
        type            probes;
        libs            ( sampling );
        writeControl    timeStep;
        writeInterval   10;
        fields          ( T U k );
        // 1–4: sim inlet (x=0.55); 5–8: sim outlet (x=1.65); centres z
        // 9–12: aisle probes; 13–20: Fig.4 inlet profile (8 sensors, bottom→top)
        probeLocations
        (
            (0.55 0.91 0.22)
            (0.55 0.91 0.66)
            (0.55 0.91 1.10)
            (0.55 0.91 1.54)
            (1.65 0.91 0.22)
            (1.65 0.91 0.66)
            (1.65 0.91 1.10)
            (1.65 0.91 1.54)
            (0.30 0.91 0.88)
            (0.30 0.91 1.232)
            (0.30 0.91 1.373)
            (1.90 0.91 0.88)
            // Fig.4: cold aisle ahead of mid rack (x=0.55, y=0.91)
            // 8 sensors uniformly from tile inlet (z=0) to domain max Z (1.98)
            // z_i = (i-0.5)/8 * 1.98
            (0.55 0.91 0.12375)
            (0.55 0.91 0.37125)
            (0.55 0.91 0.61875)
            (0.55 0.91 0.86625)
            (0.55 0.91 1.11375)
            (0.55 0.91 1.36125)
            (0.55 0.91 1.60875)
            (0.55 0.91 1.85625)
            // Side-aisle probes (neighbour rack columns are solid blanks)
            (0.3 0.2 0.6)
            (0.3 1.6 0.6)
            // Mid-rack porous path check (expect |U| > 0)
            (1.0 0.91 0.6)
        );
    }
    sets_coldAisle
    {
        type            sets;
        libs            ( sampling );
        writeControl    timeStep;
        writeInterval   100;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          ( T U k );
        sets
        {
            line_x_z07
            {
                type            uniform;
                axis            x;
                start           (0.05 0.91 1.232);
                end             (0.55 0.91 1.232);
                nPoints         40;
            }
            line_z_mid
            {
                type            uniform;
                axis            z;
                start           (0.30 0.91 0.05);
                end             (0.30 0.91 1.93);
                nPoints         60;
            }
            line_y_s4in
            {
                type            uniform;
                axis            y;
                start           (0.55 0.05 1.54);
                end             (0.55 1.77 1.54);
                nPoints         50;
            }
        }
    }
}


