// Porous (Saiyad Table 2 + STAR 85% server treatment, OpenFOAM mapping):
//   Pv=0.50 → d_x = Pv/(rho*nu) = 0.50/(1.2*1.5e-5) ≈ 27778 1/m²
//   Pi=0.05 → f_x = 2*Pi/rho = 2*0.05/1.2 ≈ 0.0833 1/m
//   Negative y,z coeffs = OF convention: |n| * d_x  (transverse ≫ streamwise),
//   so flow is forced front→back through the servers (paper intent).
//   STAR porosity 85% is the fluid volume fraction of the region; resistances
//   already include packing — we do not further scale d,f by (1-γ).
//
// Fans (paper §3): manufacturer fan curve at each server EXIT (Nelson 2007).
//   OpenFOAM: meanVelocityForce on thin exit cellZones (x=1.55–1.60).
//   Mid sims Ubar=1.5 → ΔT≈6 K at 10 kW (Fig.5). Neighbours milder Ubar so
//   tile mass (~1.68 m³/s) is not over-driven (true fan curves self-balance).
//
// Heat: Su_T absolute = Q/(rho*Cp), rho=1.2, Cp=1005.

rackLeftPorosity
{
    type            explicitPorositySource;
    active          yes;

    explicitPorositySourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        rackLeft;

        type            DarcyForchheimer;
        d   (27778 -1000 -1000);
        f   (0.0833 -1000 -1000);

        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1      (1 0 0);
                e2      (0 1 0);
            }
        }
    }
}

