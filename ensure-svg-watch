#!/bin/bash
# Background SVG watcher: residuals + Fig.4/5/8 validation every 100 iterations.
#
# Usage (from this case directory, on the Mac host):
#   ./ensure-svg-watch
#   ./ensure-svg-watch --background
#   ./ensure-svg-watch --stop
#   ./ensure-svg-watch --status
#   SVG_WATCH=0 ./Run          # disable from Run
set -euo pipefail
cd "${0%/*}" || exit 1

CASE="$(pwd)"
DATA="$CASE/Reports/data"
PIDFILE="$DATA/.svg_watch.pid"
LOG="$DATA/svg_watch.log"
RUNNER="$DATA/.svg_watch_runner.sh"
INTERVAL="${INTERVAL:-100}"
POLL="${POLL:-8}"
BACKGROUND=0
ACTION=start

while [ "$#" -gt 0 ]; do
    case "$1" in
        --background|-b) BACKGROUND=1 ;;
        --stop) ACTION=stop ;;
        --status) ACTION=status ;;
        --help|-h)
            sed -n '2,12p' "$0"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
        *) break ;;
    esac
    shift
done

mkdir -p "$DATA"

is_running() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid="$(tr -d '[:space:]' < "$PIDFILE" || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

stop_watch() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid="$(tr -d '[:space:]' < "$PIDFILE")"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 0.2
            kill -9 "$pid" 2>/dev/null || true
            echo "Stopped SVG watch (pid $pid)"
        else
            echo "SVG watch not running"
        fi
        rm -f "$PIDFILE"
    else
        echo "SVG watch not running"
    fi
}

status_watch() {
    if is_running; then
        echo "SVG watch running (pid $(tr -d '[:space:]' < "$PIDFILE"))"
        echo "Log: $LOG"
        return 0
    fi
    echo "SVG watch not running"
    return 1
}

start_watch() {
    if is_running; then
        if [ "$BACKGROUND" -eq 0 ]; then
            echo "SVG watch already running (pid $(tr -d '[:space:]' < "$PIDFILE"))"
        fi
        return 0
    fi

    if [ -f /.dockerenv ]; then
        echo "NOTE: SVG watch must run on the Mac host (not inside OpenFOAM docker)."
        echo "      In another terminal:"
        echo "        cd \"$CASE\" && ./ensure-svg-watch --background"
        return 0
    fi

    local py
    py="$(command -v python3 || true)"
    if [ -z "$py" ]; then
        echo "ERROR: python3 not found" >&2
        return 1
    fi

    cat >"$RUNNER" <<EOF
#!/bin/bash
set -euo pipefail
cd "$CASE" || exit 1
PY="$py"
INTERVAL="$INTERVAL"
POLL="$POLL"
echo "[\$(date '+%F %T')] SVG watch start: Saiyad2022_rackLevel interval=\$INTERVAL poll=\$POLL"
set +e
while true; do
    "\$PY" Reports/scripts/update_live_svgs.py --interval "\$INTERVAL"
    sleep "\$POLL"
done
EOF
    chmod +x "$RUNNER"

    python3 - "$RUNNER" "$LOG" "$PIDFILE" <<'PY'
import subprocess, sys
from pathlib import Path
runner, log_path, pid_path = sys.argv[1:4]
log = open(log_path, "a", buffering=1)
proc = subprocess.Popen(
    ["bash", runner],
    stdin=subprocess.DEVNULL,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
Path(pid_path).write_text(f"{proc.pid}\n")
PY
    sleep 0.4
    local pid
    pid="$(tr -d '[:space:]' < "$PIDFILE" || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        echo "ERROR: SVG watch failed to start — see $LOG" >&2
        rm -f "$PIDFILE"
        return 1
    fi
    echo "Started SVG watch (pid $pid)"
    echo "Log: $LOG"
    echo "Figures: Reports/figures/{residuals,fig4_*,fig5_*,fig8*,Tin_Tout_history}.svg"
}

case "$ACTION" in
    stop) stop_watch ;;
    status) status_watch ;;
    start) start_watch ;;
esac
