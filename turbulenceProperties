FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    // RNG k−ε — same RAS model as HVAC Nielsen / GIT validation cases
    // (Validation-study/OpenFOAM/HVAC). Saiyad paper RANS baseline was
    // standard k−ε; RNG kept here for indoor/buoyant airflow practice.
    model           RNGkEpsilon;
    turbulence      on;
    printCoeffs     on;
}


