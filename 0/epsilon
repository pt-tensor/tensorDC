FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

// eps ≈ Cmu^0.75 k^1.5 / L ; L ≈ 0.07×tile width (0.6 m) ≈ 0.042
internalField   uniform 0.0018;

boundaryField
{
    tileInlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.042;
        value           uniform 0.0018;
    }
    returnOutlet
    {
        type            inletOutlet;
        inletValue      uniform 0.0018;
        value           uniform 0.0018;
    }
    "(floorRack|floorHot|ceiling|rackCanopy|front|back|sideCold|sideHot|floor_.*|ceil_.*|rackTop.*|rackSide.*)"
    {
        // HVAC validation reference
        type            epsilonWallFunction;
        lowReCorrection on;
        value           uniform 0.0018;
    }
}


