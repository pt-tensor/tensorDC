FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Air @ ~17 °C supply; Boussinesq buoyancy (paper §2.2 / §3)
nu              1.5e-05;
beta            3.447e-03;   // ~1/290.15
TRef            290.15;
Pr              0.7;
Prt             0.85;


