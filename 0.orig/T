FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 290.15;

boundaryField
{
    tileInlet
    {
        type            fixedValue;
        value           uniform 290.15;
    }
    returnOutlet
    {
        type            inletOutlet;
        inletValue      uniform 290.15;
        value           uniform 290.15;
    }
    "(floorRack|floorHot|ceiling|rackCanopy|front|back|sideCold|sideHot|floor_.*|ceil_.*|rackTop.*|rackSide.*)"
    {
        type            zeroGradient;
    }
}


